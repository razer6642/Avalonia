<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyAvaloniaApp.ViewModels"
             xmlns:models="using:MyAvaloniaApp.Models"
             x:Class="MyAvaloniaApp.Views.PersonajesView"
             x:DataType="vm:PersonajesViewModel">

    <DockPanel Margin="30">
        <TextBlock DockPanel.Dock="Top"
                   Text="Personajes"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#B8860B"
                   Margin="0,0,0,16"/>

        <TextBox DockPanel.Dock="Top"
                 Text="{Binding Busqueda}"
                 Watermark="Buscar por nombre o clase..."
                 Margin="0,0,0,10"/>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Main.MensajeApi}"
                   Foreground="#E06C6C"
                   TextWrapping="Wrap"/>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,16,0,0">
            <Button Content="Nuevo personaje" Command="{Binding NuevoPersonajeCommand}" />
            <Button Content="Volver" Command="{Binding VolverCommand}" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Filtrados}"
                 SelectedItem="{Binding SelectedPersonaje}"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Personaje">
                    <Border Background="#2A211C"
                            BorderBrush="#B8860B"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Nombre}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#B8860B"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Raza}" Foreground="#E8DCC4"/>
                                <TextBlock Text="·" Foreground="#A69378"/>
                                <TextBlock Text="{Binding Clase}" Foreground="#E8DCC4"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Nivel, StringFormat='Nivel {0}'}"
                                       Foreground="#A69378"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>